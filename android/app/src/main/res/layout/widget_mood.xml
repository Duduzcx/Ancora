<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Como está o seu mar?" — 4 humores e 3 pérolas dos Logs, um toque para registrar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_question"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_calmo"
            style="@style/NoricaWidgetButton"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_calmo"
            android:text="@string/widget_calmo"
            android:textColor="#FF6EE7B7" />

        <TextView
            android:id="@+id/widget_ansioso"
            style="@style/NoricaWidgetButton"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_ansioso"
            android:text="@string/widget_ansioso"
            android:textColor="#FFFCD34D" />

        <TextView
            android:id="@+id/widget_agitado"
            style="@style/NoricaWidgetButton"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_agitado"
            android:text="@string/widget_agitado"
            android:textColor="#FFFDA4AF" />

        <TextView
            android:id="@+id/widget_sos"
            style="@style/NoricaWidgetButton"
            android:background="@drawable/widget_btn_sos"
            android:text="@string/widget_sos"
            android:textColor="#FF93C5FD" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_agua"
            style="@style/NoricaWidgetButton"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_habit"
            android:maxLines="1"
            android:text="@string/widget_agua"
            android:textColor="#FFBAE6FD"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_respirei"
            style="@style/NoricaWidgetButton"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_habit"
            android:maxLines="1"
            android:text="@string/widget_respirei"
            android:textColor="#FFBAE6FD"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_sai"
            style="@style/NoricaWidgetButton"
            android:background="@drawable/widget_btn_habit"
            android:maxLines="1"
            android:text="@string/widget_sai"
            android:textColor="#FFBAE6FD"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
