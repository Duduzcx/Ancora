<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_norica"
        android:label="Nórica"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Funciona sozinho, sem precisar do celular por perto -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

        <activity
            android:name="com.zcx.ancora.wear.MainActivity"
            android:exported="true"
            android:taskAffinity=".main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.zcx.ancora.wear.BreathActivity" android:exported="false" />
        <activity android:name="com.zcx.ancora.wear.SosActivity" android:exported="false" />
    </application>
</manifest>
